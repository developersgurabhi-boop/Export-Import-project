# Copy to .env for local development. Never commit .env.
NODE_ENV=development
APP_ROLE=api
PORT=3001

# Local dev Postgres from compose (see README)
DATABASE_URL=postgresql://tms:tms@localhost:5432/tms?schema=public

# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-32-plus-character-random-secret
JWT_ACCESS_TTL_SECONDS=900

# Comma-separated list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Used only by `pnpm db:seed` / `npm run db:seed` to create the first admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password
